<Window x:Class="OpenTrackpad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTrackpad"
        Width="760"
        Height="840"
        MinWidth="680"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="24,18,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="13"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center">
                    <Border Width="24" Height="17" CornerRadius="4"
                            BorderBrush="#FFFFFF" BorderThickness="1.5"
                            Background="#18FFFFFF"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="8" Height="1.5" Background="#FFFFFF"
                                CornerRadius="1" Opacity="0.8"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,3" />
                    </Border>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OpenTrackpad" FontSize="21" FontWeight="SemiBold" />
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="7,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="v0.0.0" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Margin="0,2,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{DynamicResource Header.StatusChecking}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="16" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BatteryBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Header.Battery}" Margin="8,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="BatteryText" Margin="6,0,0,0" FontSize="12.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Text="--%" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="RefreshButton" Content="↻" Style="{StaticResource IconButton}"
                            ToolTip="{DynamicResource Common.RefreshBattery}" Click="RefreshButton_Click" />
                </StackPanel>

                <TextBlock x:Name="AdminText" Grid.Row="1" Grid.Column="1" Margin="14,6,0,0"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="RestartAdminButton" Grid.Row="1" Grid.Column="2"
                        Content="{DynamicResource Header.RestartAdmin}" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Right" Click="RestartAdmin_Click" />
            </Grid>
        </Border>

        <Border x:Name="HealthBanner"
                Grid.Row="1"
                Visibility="Collapsed"
                Background="#2A2418"
                BorderBrush="#7A5C1E"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="⚠"
                           FontSize="18"
                           Foreground="#F0B429"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HealthTitleText"
                               FontWeight="SemiBold"
                               Foreground="#F0B429" />
                    <TextBlock x:Name="HealthDetailText"
                               Style="{StaticResource SectionHintText}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HealthFixButton"
                            Style="{StaticResource PrimaryButton}"
                            Click="HealthFix_Click" />
                    <Button x:Name="HealthDetailsButton"
                            Content="{DynamicResource Health.Details}"
                            Margin="8,0,0,0"
                            Click="ShowDriverStatus_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="24,18,24,12">
            <TabItem Header="{DynamicResource Tab.PointClick}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="{DynamicResource PointClick.TrackingSpeed}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource PointClick.TrackingSpeedHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="CursorSpeedSlider" Minimum="1" Maximum="20"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="CursorSpeedSlider_ValueChanged" />
                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeBorder}">
                                <TextBlock x:Name="CursorSpeedValueText"
                                           Style="{StaticResource ValueBadgeText}" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="{DynamicResource Common.Slow}" Style="{StaticResource SectionHintText}" />
                            <TextBlock Text="{DynamicResource Common.Fast}" Style="{StaticResource SectionHintText}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="{DynamicResource PointClick.Sensitivity}"
                                   Style="{StaticResource SectionTitleText}" Margin="0,16,0,0" />
                        <TextBlock Text="{DynamicResource PointClick.SensitivityHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <ComboBox x:Name="SensitivityComboBox" Width="280"
                                  HorizontalAlignment="Left" Margin="0,8,0,0"
                                  SelectionChanged="SensitivityComboBox_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Sensitivity.Most}" />
                            <ComboBoxItem Content="{DynamicResource Sensitivity.High}" />
                            <ComboBoxItem Content="{DynamicResource Sensitivity.Medium}" />
                            <ComboBoxItem Content="{DynamicResource Sensitivity.Low}" />
                            <ComboBoxItem Content="{DynamicResource Sensitivity.Least}" />
                        </ComboBox>

                        <Border Style="{StaticResource DividerBorder}" />

                        <TextBlock Text="{DynamicResource PointClick.Click}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource PointClick.ClickHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <ComboBox x:Name="ClickStrengthComboBox" Width="220"
                                  HorizontalAlignment="Left" Margin="0,10,0,0"
                                  SelectionChanged="ClickStrengthComboBox_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Click.Off}" />
                            <ComboBoxItem Content="{DynamicResource Click.Light}" />
                            <ComboBoxItem Content="{DynamicResource Click.Medium}" />
                            <ComboBoxItem Content="{DynamicResource Click.Firm}" />
                        </ComboBox>
                        <Button x:Name="PreviewClickButton" Content="{DynamicResource PointClick.Preview}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Click="PreviewClick_Click" />
                        <TextBlock x:Name="ClickStatusText" Margin="0,8,0,0"
                                   Style="{StaticResource SectionHintText}" />

                        <TextBlock Text="{DynamicResource PointClick.OtherOptions}"
                                   Style="{StaticResource SectionHintText}" Margin="0,14,0,0" />
                        <CheckBox x:Name="DisableFeedbackCheckBox"
                                  Content="{DynamicResource PointClick.Disable}"
                                  Margin="0,8,0,0"
                                  Checked="DisableFeedbackCheckBox_Changed"
                                  Unchecked="DisableFeedbackCheckBox_Changed" />

                        <Border Style="{StaticResource DividerBorder}" />

                        <TextBlock Text="{DynamicResource PointClick.Secondary}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource PointClick.SecondaryHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <CheckBox x:Name="SecondaryClickCheckBox"
                                  Content="{DynamicResource PointClick.SecondaryTwoFinger}"
                                  Margin="0,10,0,0"
                                  Checked="SecondaryClickCheckBox_Changed"
                                  Unchecked="SecondaryClickCheckBox_Changed" />
                        <CheckBox x:Name="RightClickZoneCheckBox"
                                  Content="{DynamicResource PointClick.RightClickZone}"
                                  Margin="0,8,0,0"
                                  Checked="RightClickZoneCheckBox_Changed"
                                  Unchecked="RightClickZoneCheckBox_Changed" />
                        <TextBlock Text="{DynamicResource PointClick.RightClickZoneHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <CheckBox x:Name="TapToClickCheckBox"
                                  Content="{DynamicResource PointClick.TapToClick}" Margin="0,8,0,0"
                                  Checked="TapToClickCheckBox_Changed"
                                  Unchecked="TapToClickCheckBox_Changed" />
                        <CheckBox x:Name="TapAndDragCheckBox"
                                  Content="{DynamicResource PointClick.TapAndDrag}" Margin="0,8,0,0"
                                  Checked="TapAndDragCheckBox_Changed"
                                  Unchecked="TapAndDragCheckBox_Changed" />
                        <TextBlock Text="{DynamicResource PointClick.TapAndDragHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />

                        <Button Content="{DynamicResource Common.ResetTab}"
                                HorizontalAlignment="Left" Margin="0,18,0,0"
                                Click="ResetPointClick_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.ScrollZoom}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="{DynamicResource Scroll.Gestures}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Scroll.GesturesHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <CheckBox x:Name="NaturalScrollCheckBox"
                                  Content="{DynamicResource Scroll.Natural}"
                                  Margin="0,10,0,0"
                                  Checked="NaturalScrollCheckBox_Changed"
                                  Unchecked="NaturalScrollCheckBox_Changed" />
                        <CheckBox x:Name="ZoomCheckBox"
                                  Content="{DynamicResource Scroll.Zoom}"
                                  Margin="0,8,0,0"
                                  Checked="ZoomCheckBox_Changed"
                                  Unchecked="ZoomCheckBox_Changed" />

                        <Border Style="{StaticResource DividerBorder}" />

                        <TextBlock Text="{DynamicResource Scroll.Speed}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Scroll.SpeedHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PanSensitivitySlider" Minimum="0" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="PanSensitivitySlider_ValueChanged" />
                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeBorder}">
                                <TextBlock x:Name="PanSensitivityValueText"
                                           Style="{StaticResource ValueBadgeText}" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource Scroll.Restore}" Padding="12,6"
                                    Click="RestoreScroll_Click" />
                            <Button Content="{DynamicResource Common.ResetTab}"
                                    Margin="8,0,0,0" Click="ResetScrollZoom_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ScrollStatusText" Margin="0,8,0,0"
                                   Style="{StaticResource SectionHintText}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.MoreGestures}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="{DynamicResource Drag.Title}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Drag.Hint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <CheckBox x:Name="DragCheckBox" Content="{DynamicResource Drag.Enable}"
                                  Margin="0,10,0,0"
                                  Checked="DragCheckBox_Changed"
                                  Unchecked="DragCheckBox_Changed" />
                        <TextBlock x:Name="DragStatusText" Margin="0,6,0,0"
                                   Style="{StaticResource SectionHintText}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SectionHintText}"
                                   Text="{DynamicResource Drag.Note}" />

                        <Border Style="{StaticResource DividerBorder}" />

                        <TextBlock Text="{DynamicResource Drag.Speed}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Drag.SpeedHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="DragGainSlider" Minimum="0.5" Maximum="1.5"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="DragGainSlider_ValueChanged" />
                            <Border Grid.Column="1" Style="{StaticResource ValueBadgeBorder}">
                                <TextBlock x:Name="DragGainValueText"
                                           Style="{StaticResource ValueBadgeText}" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                            <TextBlock Text="{DynamicResource Common.Slow}" Style="{StaticResource SectionHintText}" />
                            <TextBlock Text="{DynamicResource Common.Fast}" Style="{StaticResource SectionHintText}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionHintText}"
                                   Text="{DynamicResource Drag.SpeedNote}" />

                        <Border Style="{StaticResource DividerBorder}" />

                        <TextBlock Text="{DynamicResource Drag.GestureNote}"
                                   Style="{StaticResource SectionHintText}" />

                        <Button Content="{DynamicResource Drag.OpenWindows}"
                                HorizontalAlignment="Left" Margin="0,16,0,0"
                                Click="OpenWindowsTouchpad_Click" />

                        <Button Content="{DynamicResource Common.ResetTab}"
                                HorizontalAlignment="Left" Margin="0,18,0,0"
                                Click="ResetMoreGestures_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource Tab.Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="{DynamicResource Advanced.Health}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Advanced.HealthHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Advanced.HealthDriver}"
                                       Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                            <TextBlock x:Name="HealthDriverValueText" Grid.Column="1"
                                       Margin="0,0,0,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Advanced.HealthAccess}"
                                       Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                            <TextBlock x:Name="HealthAccessValueText" Grid.Row="1" Grid.Column="1"
                                       Margin="0,0,0,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="{DynamicResource Advanced.HealthDevice}"
                                       Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                            <TextBlock x:Name="HealthDeviceValueText" Grid.Row="2" Grid.Column="1"
                                       Margin="0,0,0,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="{DynamicResource Advanced.HealthBattery}"
                                       Style="{StaticResource FieldLabelText}" />
                            <TextBlock x:Name="HealthBatteryValueText" Grid.Row="3" Grid.Column="1"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource Health.Refresh}"
                                    Click="RefreshHealth_Click" />
                            <Button Content="{DynamicResource Health.Details}"
                                    Margin="8,0,0,0" Click="ShowDriverStatus_Click" />
                            <Button x:Name="EnableAccessButton"
                                    Content="{DynamicResource Health.EnableAccess}"
                                    Margin="8,0,0,0" Click="EnableAccess_Click" />
                        </StackPanel>
                        <TextBlock x:Name="HealthStatusText" Margin="0,6,0,0"
                                   Style="{StaticResource SectionHintText}" />

                        <Border Style="{StaticResource DividerBorder}" />

                        <TextBlock Text="{DynamicResource Advanced.Pointer}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Advanced.PointerHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Advanced.StopPressure}" Style="{StaticResource FieldLabelText}"
                                       Margin="0,0,12,8" />
                            <TextBox x:Name="StopPressureBox" Grid.Column="1" Margin="0,0,0,8"
                                     TextChanged="PointerControl_Changed" />
                            <TextBlock Grid.Row="1" Text="{DynamicResource Advanced.StopSize}"
                                       Style="{StaticResource FieldLabelText}" Margin="0,0,12,0" />
                            <TextBox x:Name="StopSizeBox" Grid.Row="1" Grid.Column="1"
                                     TextChanged="PointerControl_Changed" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Advanced.StopHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,4,0,0" />

                        <CheckBox x:Name="IgnoreNearFingersCheck" Content="{DynamicResource Advanced.IgnoreNear}"
                                  Margin="0,12,0,0"
                                  Checked="PointerControl_Changed"
                                  Unchecked="PointerControl_Changed" />
                        <CheckBox x:Name="PalmRejectionCheck" Content="{DynamicResource Advanced.Palm}"
                                  Margin="0,8,0,0"
                                  Checked="PointerControl_Changed"
                                  Unchecked="PointerControl_Changed" />
                        <CheckBox x:Name="IgnoreButtonFingerCheck"
                                  Content="{DynamicResource Advanced.IgnoreButton}"
                                  Margin="0,8,0,0"
                                  Checked="PointerControl_Changed"
                                  Unchecked="PointerControl_Changed" />
                        <CheckBox x:Name="LeaveOnWithMouseCheckBox"
                                  Content="{DynamicResource Advanced.LeaveOnWithMouse}"
                                  Margin="0,8,0,0"
                                  Checked="LeaveOnWithMouseCheckBox_Changed"
                                  Unchecked="LeaveOnWithMouseCheckBox_Changed" />
                        <TextBlock Text="{DynamicResource Advanced.LeaveOnWithMouseHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{DynamicResource Advanced.Load}" Click="ReloadPointer_Click" />
                            <Button Content="{DynamicResource Advanced.LiftPreset}"
                                    Margin="8,0,0,0" Click="ApplyLiftPreset_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource SectionHintText}"
                                   Text="{DynamicResource Advanced.LiftPresetHint}" />
                        <TextBlock x:Name="PointerStatusText" Margin="0,8,0,0"
                                   Style="{StaticResource SectionHintText}" />

                        <Border Style="{StaticResource DividerBorder}" />

                        <TextBlock Text="{DynamicResource Advanced.Connection}" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource Advanced.ConnectionHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <Button Content="{DynamicResource Advanced.OpenBluetooth}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="OpenBluetoothSettings_Click" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource SectionHintText}"
                                   Text="{DynamicResource Advanced.BluetoothNote}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource SectionHintText}"
                                   Text="{DynamicResource Advanced.BluetoothWarning}" />

                        <Border Style="{StaticResource DividerBorder}" />

                        <TextBlock Text="{DynamicResource Advanced.General}" Style="{StaticResource SectionTitleText}" />
                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="{DynamicResource Advanced.StartWithWindows}"
                                  Margin="0,8,0,0"
                                  Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed" />
                        <Button Content="{DynamicResource Advanced.OpenLogs}"
                                HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="OpenLogFolder_Click" />
                        <Button x:Name="ExportDiagnosticsButton"
                                Content="{DynamicResource Advanced.ExportDiagnostics}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                Click="ExportDiagnostics_Click" />
                        <TextBlock x:Name="DiagnosticsStatusText" Margin="0,6,0,0"
                                   Style="{StaticResource SectionHintText}" />

                        <TextBlock Text="{DynamicResource Advanced.Language}"
                                   Style="{StaticResource FieldLabelText}" Margin="0,14,0,0" />
                        <TextBlock Text="{DynamicResource Advanced.LanguageHint}"
                                   Style="{StaticResource SectionHintText}" Margin="0,2,0,0" />
                        <ComboBox x:Name="LanguageComboBox" Width="180"
                                  HorizontalAlignment="Left" Margin="0,8,0,0"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource Language.Thai}" />
                            <ComboBoxItem Content="{DynamicResource Language.English}" />
                        </ComboBox>

                        <Button Content="{DynamicResource Common.ResetTab}"
                                HorizontalAlignment="Left" Margin="0,18,0,0"
                                Click="ResetAdvanced_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Footer.TrayHint}"
                               Style="{StaticResource SectionHintText}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="FooterVersionText" Text="v0.0.0"
                               Margin="12,0,0,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="{DynamicResource Common.Close}" Padding="16,6" HorizontalAlignment="Right"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
