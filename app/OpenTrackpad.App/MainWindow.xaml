<Window x:Class="OpenTrackpad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTrackpad"
        Width="920"
        Height="700"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="0,20,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Margin="14,0,14,16"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock Text="{DynamicResource Header.Battery}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="RefreshButton" Content="↻"
                                    Style="{StaticResource IconButton}"
                                    Width="28" Height="28"
                                    ToolTip="{DynamicResource Common.RefreshBattery}"
                                    AutomationProperties.Name="{DynamicResource Common.RefreshBattery}"
                                    HorizontalAlignment="Right"
                                    Click="RefreshButton_Click" />
                        </DockPanel>

                        <TextBlock x:Name="BatteryText" Grid.Row="1"
                                   Text="--%" FontSize="26" FontWeight="SemiBold"
                                   Margin="0,2,0,0" />

                        <TextBlock x:Name="StatusText" Grid.Row="2"
                                   Text="{DynamicResource Header.StatusChecking}"
                                   Style="{StaticResource SettingHintText}"
                                   Margin="0,2,0,0" />
                    </Grid>
                </Border>

                <ListBox x:Name="NavList" Grid.Row="1"
                         Style="{StaticResource NavList}"
                         SelectedIndex="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem AutomationProperties.Name="{DynamicResource Tab.PointClick}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPointer}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Tab.PointClick}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{DynamicResource Tab.ScrollGestures}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconScroll}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  StrokeThickness="1.6"
                                  Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Tab.ScrollGestures}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{DynamicResource Tab.DeviceApp}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDevice}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  StrokeThickness="1.5"
                                  Fill="Transparent"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Tab.DeviceApp}"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HealthBanner"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{DynamicResource WarningBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="⚠"
                               FontSize="18"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HealthTitleText"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock x:Name="HealthDetailText"
                                   Style="{StaticResource SettingHintText}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HealthFixButton"
                                Style="{StaticResource PrimaryButton}"
                                Click="HealthFix_Click" />
                        <Button x:Name="HealthDetailsButton"
                                Content="{DynamicResource Health.Details}"
                                Margin="8,0,0,0"
                                Click="ShowDriverStatus_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="PointerPage" Visibility="Visible"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,28">
                            <TextBlock Text="{DynamicResource Page.PointerHint}"
                                       Style="{StaticResource PageHintText}"
                                       Margin="0,0,0,18" />

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.Movement}"
                                               Style="{StaticResource CardTitleText}" />

                                    <Grid Margin="0,14,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{DynamicResource PointClick.TrackingSpeed}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource PointClick.TrackingSpeedHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="CursorSpeedSlider" Width="170"
                                                        AutomationProperties.Name="{DynamicResource PointClick.TrackingSpeed}"
                                                        Minimum="1" Maximum="20"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        ValueChanged="CursorSpeedSlider_ValueChanged" />
                                                <Border Grid.Column="1" Style="{StaticResource ValueBadgeBorder}">
                                                    <TextBlock x:Name="CursorSpeedValueText"
                                                               Style="{StaticResource ValueBadgeText}" />
                                                </Border>
                                            </StackPanel>
                                            <Grid Width="170" Margin="0,2,0,0">
                                                <TextBlock Text="{DynamicResource Common.Slow}"
                                                           Style="{StaticResource SettingHintText}" />
                                                <TextBlock Text="{DynamicResource Common.Fast}"
                                                           Style="{StaticResource SettingHintText}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{DynamicResource PointClick.Sensitivity}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource PointClick.SensitivityHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="SensitivityComboBox" Grid.Column="1"
                                                  Width="180" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{DynamicResource PointClick.Sensitivity}"
                                                  SelectionChanged="SensitivityComboBox_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource Sensitivity.Most}" />
                                            <ComboBoxItem Content="{DynamicResource Sensitivity.High}" />
                                            <ComboBoxItem Content="{DynamicResource Sensitivity.Medium}" />
                                            <ComboBoxItem Content="{DynamicResource Sensitivity.Low}" />
                                            <ComboBoxItem Content="{DynamicResource Sensitivity.Least}" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.Clicks}"
                                               Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="{DynamicResource PointClick.ClickHint}"
                                               Style="{StaticResource CardHintText}"
                                               Margin="0,2,0,0" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource PointClick.Click}"
                                                   Style="{StaticResource SettingLabelText}"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="ClickStrengthComboBox" Grid.Column="1"
                                                  Width="160" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{DynamicResource PointClick.Click}"
                                                  SelectionChanged="ClickStrengthComboBox_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource Click.Off}" />
                                            <ComboBoxItem Content="{DynamicResource Click.Light}" />
                                            <ComboBoxItem Content="{DynamicResource Click.Medium}" />
                                            <ComboBoxItem Content="{DynamicResource Click.Firm}" />
                                        </ComboBox>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="PreviewClickButton"
                                                Content="{DynamicResource PointClick.Preview}"
                                                Style="{StaticResource PrimaryButton}"
                                                Click="PreviewClick_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="ClickStatusText"
                                               Style="{StaticResource SettingHintText}"
                                               Margin="0,8,0,0" />

                                    <Border Height="1" Background="{DynamicResource DividerBrush}"
                                            Margin="0,14,0,14" />

                                    <CheckBox x:Name="SecondaryClickCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource PointClick.SecondaryTwoFinger}"
                                              Margin="0,0,0,14"
                                              Checked="SecondaryClickCheckBox_Changed"
                                              Unchecked="SecondaryClickCheckBox_Changed">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource PointClick.SecondaryTwoFinger}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource PointClick.SecondaryHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="RightClickZoneCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource PointClick.RightClickZone}"
                                              Margin="0,0,0,14"
                                              Checked="RightClickZoneCheckBox_Changed"
                                              Unchecked="RightClickZoneCheckBox_Changed">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource PointClick.RightClickZone}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource PointClick.RightClickZoneHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </CheckBox>

                                    <CheckBox x:Name="TapToClickCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              Margin="0,0,0,14"
                                              Checked="TapToClickCheckBox_Changed"
                                              Unchecked="TapToClickCheckBox_Changed">
                                        <TextBlock Text="{DynamicResource PointClick.TapToClick}"
                                                   Style="{StaticResource SettingLabelText}" />
                                    </CheckBox>

                                    <CheckBox x:Name="TapAndDragCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource PointClick.TapAndDrag}"
                                              Margin="0,0,0,14"
                                              Checked="TapAndDragCheckBox_Changed"
                                              Unchecked="TapAndDragCheckBox_Changed">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource PointClick.TapAndDrag}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource PointClick.TapAndDragHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </CheckBox>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}"
                                            Margin="0,0,0,14" />

                                    <CheckBox x:Name="DisableFeedbackCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource PointClick.Disable}"
                                              Checked="DisableFeedbackCheckBox_Changed"
                                              Unchecked="DisableFeedbackCheckBox_Changed">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource PointClick.Disable}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource PointClick.DisableHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <Expander Style="{StaticResource CardExpander}"
                                      AutomationProperties.Name="{DynamicResource Card.AdvancedPointer}">
                                <Expander.Header>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Card.AdvancedPointer}"
                                                   Style="{StaticResource CardTitleText}" />
                                        <TextBlock Text="{DynamicResource Card.AdvancedPointerHint}"
                                                   Style="{StaticResource CardHintText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Advanced.StopPressure}"
                                                   Style="{StaticResource SettingLabelText}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="StopPressureBox" Grid.Column="1"
                                                 Width="150" Margin="16,0,0,0"
                                                 AutomationProperties.Name="{DynamicResource Advanced.StopPressure}"
                                                 TextChanged="PointerControl_Changed" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Advanced.StopSize}"
                                                   Style="{StaticResource SettingLabelText}"
                                                   VerticalAlignment="Center" />
                                        <TextBox x:Name="StopSizeBox" Grid.Column="1"
                                                 Width="150" Margin="16,0,0,0"
                                                 AutomationProperties.Name="{DynamicResource Advanced.StopSize}"
                                                 TextChanged="PointerControl_Changed" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Advanced.StopHint}"
                                               Style="{StaticResource SettingHintText}"
                                               Margin="0,0,0,14" />

                                    <CheckBox x:Name="IgnoreNearFingersCheck"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource Advanced.IgnoreNear}"
                                              Margin="0,0,0,12"
                                              Checked="PointerControl_Changed"
                                              Unchecked="PointerControl_Changed">
                                        <TextBlock Text="{DynamicResource Advanced.IgnoreNear}"
                                                   Style="{StaticResource SettingLabelText}" />
                                    </CheckBox>
                                    <CheckBox x:Name="PalmRejectionCheck"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource Advanced.Palm}"
                                              Margin="0,0,0,12"
                                              Checked="PointerControl_Changed"
                                              Unchecked="PointerControl_Changed">
                                        <TextBlock Text="{DynamicResource Advanced.Palm}"
                                                   Style="{StaticResource SettingLabelText}" />
                                    </CheckBox>
                                    <CheckBox x:Name="IgnoreButtonFingerCheck"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource Advanced.IgnoreButton}"
                                              Margin="0,0,0,12"
                                              Checked="PointerControl_Changed"
                                              Unchecked="PointerControl_Changed">
                                        <TextBlock Text="{DynamicResource Advanced.IgnoreButton}"
                                                   Style="{StaticResource SettingLabelText}" />
                                    </CheckBox>
                                    <CheckBox x:Name="LeaveOnWithMouseCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource Advanced.LeaveOnWithMouse}"
                                              Margin="0,0,0,4"
                                              Checked="LeaveOnWithMouseCheckBox_Changed"
                                              Unchecked="LeaveOnWithMouseCheckBox_Changed">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Advanced.LeaveOnWithMouse}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource Advanced.LeaveOnWithMouseHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </CheckBox>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource Advanced.Load}"
                                                Click="ReloadPointer_Click" />
                                        <Button Content="{DynamicResource Advanced.LiftPreset}"
                                                Margin="8,0,0,0" Click="ApplyLiftPreset_Click" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Advanced.LiftPresetHint}"
                                               Style="{StaticResource SettingHintText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>

                            <Button Content="{DynamicResource Common.ResetTab}"
                                    Style="{StaticResource GhostLinkButton}"
                                    HorizontalAlignment="Right"
                                    Click="ResetPointClick_Click" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ScrollPage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,28">
                            <TextBlock Text="{DynamicResource Page.ScrollHint}"
                                       Style="{StaticResource PageHintText}"
                                       Margin="0,0,0,18" />

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.Scrolling}"
                                               Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="{DynamicResource Scroll.GesturesHint}"
                                               Style="{StaticResource CardHintText}"
                                               Margin="0,2,0,14" />

                                    <CheckBox x:Name="NaturalScrollCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource Scroll.Natural}"
                                              Margin="0,0,0,12"
                                              Checked="NaturalScrollCheckBox_Changed"
                                              Unchecked="NaturalScrollCheckBox_Changed">
                                        <TextBlock Text="{DynamicResource Scroll.Natural}"
                                                   Style="{StaticResource SettingLabelText}" />
                                    </CheckBox>

                                    <CheckBox x:Name="ZoomCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource Scroll.Zoom}"
                                              Margin="0,0,0,16"
                                              Checked="ZoomCheckBox_Changed"
                                              Unchecked="ZoomCheckBox_Changed">
                                        <TextBlock Text="{DynamicResource Scroll.Zoom}"
                                                   Style="{StaticResource SettingLabelText}" />
                                    </CheckBox>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{DynamicResource Scroll.Speed}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource Scroll.SpeedHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="PanSensitivitySlider" Width="170"
                                                        AutomationProperties.Name="{DynamicResource Scroll.Speed}"
                                                        Minimum="0" Maximum="100"
                                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                                        ValueChanged="PanSensitivitySlider_ValueChanged" />
                                                <Border Style="{StaticResource ValueBadgeBorder}">
                                                    <TextBlock x:Name="PanSensitivityValueText"
                                                               Style="{StaticResource ValueBadgeText}" />
                                                </Border>
                                            </StackPanel>
                                            <Grid Width="170" Margin="0,2,0,0">
                                                <TextBlock Text="{DynamicResource Common.Slow}"
                                                           Style="{StaticResource SettingHintText}" />
                                                <TextBlock Text="{DynamicResource Common.Fast}"
                                                           Style="{StaticResource SettingHintText}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <Button Content="{DynamicResource Scroll.Restore}"
                                            HorizontalAlignment="Left"
                                            Margin="0,14,0,0"
                                            Click="RestoreScroll_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <Grid>
                                        <DockPanel>
                                            <Border x:Name="DragStatusBadge"
                                                    DockPanel.Dock="Right"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="6" Padding="8,2"
                                                    VerticalAlignment="Top">
                                                <TextBlock x:Name="DragStatusText"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource Card.Drag}"
                                                       Style="{StaticResource CardTitleText}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Drag.Hint}"
                                               Style="{StaticResource CardHintText}"
                                               Margin="0,2,0,14" />

                                    <CheckBox x:Name="DragCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource Drag.Enable}"
                                              Margin="0,0,0,12"
                                              Checked="DragCheckBox_Changed"
                                              Unchecked="DragCheckBox_Changed">
                                        <TextBlock Text="{DynamicResource Drag.Enable}"
                                                   Style="{StaticResource SettingLabelText}" />
                                    </CheckBox>
                                    <TextBlock Text="{DynamicResource Drag.Note}"
                                               Style="{StaticResource SettingHintText}"
                                               Margin="0,0,0,16" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{DynamicResource Drag.Speed}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource Drag.SpeedHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Slider x:Name="DragGainSlider" Width="170"
                                                        AutomationProperties.Name="{DynamicResource Drag.Speed}"
                                                        Minimum="0.5" Maximum="1.5"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                        ValueChanged="DragGainSlider_ValueChanged" />
                                                <Border Style="{StaticResource ValueBadgeBorder}">
                                                    <TextBlock x:Name="DragGainValueText"
                                                               Style="{StaticResource ValueBadgeText}" />
                                                </Border>
                                            </StackPanel>
                                            <Grid Width="170" Margin="0,2,0,0">
                                                <TextBlock Text="{DynamicResource Common.Slow}"
                                                           Style="{StaticResource SettingHintText}" />
                                                <TextBlock Text="{DynamicResource Common.Fast}"
                                                           Style="{StaticResource SettingHintText}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Drag.SpeedNote}"
                                               Style="{StaticResource SettingHintText}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.WindowsGestures}"
                                               Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="{DynamicResource Drag.GestureNote}"
                                               Style="{StaticResource CardHintText}"
                                               Margin="0,4,0,12" />
                                    <Button Content="{DynamicResource Drag.OpenWindows}"
                                            HorizontalAlignment="Left"
                                            Click="OpenWindowsTouchpad_Click" />
                                </StackPanel>
                            </Border>

                            <Button Content="{DynamicResource Common.ResetTab}"
                                    Style="{StaticResource GhostLinkButton}"
                                    HorizontalAlignment="Right"
                                    Click="ResetScrollGestures_Click" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DevicePage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,28">
                            <TextBlock Text="{DynamicResource Page.DeviceHint}"
                                       Style="{StaticResource PageHintText}"
                                       Margin="0,0,0,18" />

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.DeviceStatus}"
                                               Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="{DynamicResource Advanced.HealthHint}"
                                               Style="{StaticResource CardHintText}"
                                               Margin="0,2,0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                                CornerRadius="8" Padding="12" Margin="0,0,6,6">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Advanced.HealthDriver}"
                                                           Style="{StaticResource SettingHintText}" />
                                                <TextBlock x:Name="HealthDriverValueText"
                                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                CornerRadius="8" Padding="12" Margin="6,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Advanced.HealthAccess}"
                                                           Style="{StaticResource SettingHintText}" />
                                                <TextBlock x:Name="HealthAccessValueText"
                                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                CornerRadius="8" Padding="12" Margin="0,6,6,0">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Advanced.HealthDevice}"
                                                           Style="{StaticResource SettingHintText}" />
                                                <TextBlock x:Name="HealthDeviceValueText"
                                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                CornerRadius="8" Padding="12" Margin="6,6,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Advanced.HealthBattery}"
                                                           Style="{StaticResource SettingHintText}" />
                                                <TextBlock x:Name="HealthBatteryValueText"
                                                           FontWeight="SemiBold" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="{DynamicResource Health.Refresh}"
                                                Click="RefreshHealth_Click" />
                                        <Button Content="{DynamicResource Health.Details}"
                                                Margin="8,0,0,0" Click="ShowDriverStatus_Click" />
                                        <Button x:Name="EnableAccessButton"
                                                Content="{DynamicResource Health.EnableAccess}"
                                                Margin="8,0,0,0" Click="EnableAccess_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.Connection}"
                                               Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="{DynamicResource Advanced.ConnectionHint}"
                                               Style="{StaticResource CardHintText}"
                                               Margin="0,2,0,12" />
                                    <Button Content="{DynamicResource Advanced.OpenBluetooth}"
                                            HorizontalAlignment="Left"
                                            Click="OpenBluetoothSettings_Click" />
                                    <TextBlock Text="{DynamicResource Advanced.BluetoothNote}"
                                               Style="{StaticResource SettingHintText}"
                                               Margin="0,10,0,0" />
                                    <TextBlock Text="{DynamicResource Advanced.BluetoothWarning}"
                                               Style="{StaticResource SettingHintText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.App}"
                                               Style="{StaticResource CardTitleText}" />

                                    <CheckBox x:Name="StartWithWindowsCheckBox"
                                              Style="{StaticResource SwitchCheckBox}"
                                              AutomationProperties.Name="{DynamicResource Advanced.StartWithWindows}"
                                              Margin="0,12,0,16"
                                              Checked="StartWithWindowsCheckBox_Changed"
                                              Unchecked="StartWithWindowsCheckBox_Changed">
                                        <TextBlock Text="{DynamicResource Advanced.StartWithWindows}"
                                                   Style="{StaticResource SettingLabelText}" />
                                    </CheckBox>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{DynamicResource Advanced.Language}"
                                                       Style="{StaticResource SettingLabelText}" />
                                            <TextBlock Text="{DynamicResource Advanced.LanguageHint}"
                                                       Style="{StaticResource SettingHintText}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1"
                                                  Width="180" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{DynamicResource Advanced.Language}"
                                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource Language.Thai}" />
                                            <ComboBoxItem Content="{DynamicResource Language.English}" />
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.Diagnostics}"
                                               Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="{DynamicResource Card.DiagnosticsHint}"
                                               Style="{StaticResource CardHintText}"
                                               Margin="0,2,0,12" />
                                    <WrapPanel>
                                        <Button Content="{DynamicResource Advanced.OpenLogs}"
                                                Click="OpenLogFolder_Click" />
                                        <Button x:Name="ExportDiagnosticsButton"
                                                Content="{DynamicResource Advanced.ExportDiagnostics}"
                                                Margin="8,0,0,0"
                                                Click="ExportDiagnostics_Click" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Card.Access}"
                                               Style="{StaticResource CardTitleText}" />
                                    <TextBlock x:Name="AdminText"
                                               Style="{StaticResource SettingHintText}"
                                               Margin="0,6,0,10" />
                                    <Button x:Name="RestartAdminButton"
                                            Content="{DynamicResource Header.RestartAdmin}"
                                            Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left"
                                            Click="RestartAdmin_Click" />
                                </StackPanel>
                            </Border>

                            <Button Content="{DynamicResource Common.ResetTab}"
                                    Style="{StaticResource GhostLinkButton}"
                                    HorizontalAlignment="Right"
                                    Click="ResetDeviceApp_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusBarIcon" Text="●" FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusBarText" Grid.Column="1"
                               Text="{DynamicResource Footer.TrayHint}"
                               Style="{StaticResource StatusMessageText}"
                               Margin="0,0,12,0" />
                    <Button Grid.Column="2"
                            Content="{DynamicResource Common.HideToTray}"
                            Padding="14,5"
                            AutomationProperties.Name="{DynamicResource Common.HideToTray}"
                            Click="CloseButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
