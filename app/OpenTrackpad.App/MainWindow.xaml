<Window x:Class="OpenTrackpad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTrackpad"
        Width="620"
        Height="820"
        MinWidth="540"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="OpenTrackpad" FontSize="26" FontWeight="Bold" />
            <TextBlock x:Name="StatusText" Margin="0,2,0,0" Foreground="DimGray"
                       Text="กำลังตรวจสอบอุปกรณ์..." />
            <TextBlock x:Name="AdminText" Margin="0,2,0,0" FontSize="11" Foreground="Gray" />
            <Button x:Name="RestartAdminButton" Content="เปิดใหม่แบบ administrator"
                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4"
                    Click="RestartAdmin_Click" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="แบตเตอรี่" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="BatteryText" Grid.Column="1" FontSize="16"
                           VerticalAlignment="Center" Margin="12,0,0,0" Text="--%" />
                <Button x:Name="RefreshButton" Grid.Column="2" Content="รีเฟรช"
                        Padding="12,4" Click="RefreshButton_Click" />
            </Grid>

            <Separator Margin="0,14" />

            <GroupBox Header="ฮาปติก (การสั่น)" Padding="12">
                <StackPanel>
                    <TextBlock Text="ระดับการสั่นเมื่อคลิก" />
                    <ComboBox x:Name="HapticPresetCombo" Width="260" HorizontalAlignment="Left"
                              Margin="0,6,0,0">
                        <ComboBoxItem Content="ปิด (เงียบ)" Tag="Off" />
                        <ComboBoxItem Content="เบา" Tag="Light" />
                        <ComboBoxItem Content="กลาง" Tag="Medium" />
                        <ComboBoxItem Content="แน่น" Tag="Firm" />
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="PreviewHapticButton" Content="ทดลองสั่น"
                                Padding="12,4" Margin="0,0,8,0" Click="PreviewHaptic_Click" />
                        <Button x:Name="ApplyHapticButton" Content="บันทึก"
                                Padding="12,4" Click="ApplyHaptic_Click" />
                    </StackPanel>
                    <TextBlock x:Name="HapticStatusText" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="Gray" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="ตัวชี้ / ฝ่ามือ / แรงกด" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Stop pressure (0xFFFFFFFF = ปิด)" VerticalAlignment="Center" />
                        <TextBox x:Name="StopPressureBox" Grid.Column="1" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="Stop size (0xFFFFFFFF = ปิด)" VerticalAlignment="Center" />
                        <TextBox x:Name="StopSizeBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                    </Grid>
                    <CheckBox x:Name="IgnoreNearFingersCheck" Content="Ignore near fingers" Margin="0,8,0,0" />
                    <CheckBox x:Name="IgnoreButtonFingerCheck" Content="Ignore button finger" Margin="0,4,0,0" />
                    <CheckBox x:Name="PalmRejectionCheck" Content="Palm rejection" Margin="0,4,0,0" />
                    <CheckBox x:Name="InvertMovementCheck" Content="Invert movement" Margin="0,4,0,0" />
                    <CheckBox x:Name="ButtonDisabledCheck" Content="ปิดปุ่มคลิกทั้งแผ่น" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="บันทึก" Padding="12,4" Margin="0,0,8,0"
                                Click="ApplyPointer_Click" />
                        <Button Content="โหลดค่าจากไดรเวอร์" Padding="12,4"
                                Click="ReloadPointer_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PointerStatusText" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="Gray" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="การเลื่อน" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="ความเร็วการเลื่อน (PanSensitivity)" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="PanSensitivitySlider" Minimum="0" Maximum="100"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="PanSensitivitySlider_ValueChanged" />
                        <TextBlock x:Name="PanSensitivityValueText" Grid.Column="1"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="บันทึก" Padding="12,4" Margin="0,0,8,0"
                                Click="ApplyScroll_Click" />
                        <Button Content="คืนค่าเดิม" Padding="12,4"
                                Click="RestoreScroll_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ScrollStatusText" Margin="0,8,0,0"
                               TextWrapping="Wrap" Foreground="Gray" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="ลาก 3 นิ้ว" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox x:Name="DragCheckBox" Content="เปิดลาก 3 นิ้ว"
                              Checked="DragCheckBox_Changed" Unchecked="DragCheckBox_Changed" />
                    <TextBlock x:Name="DragStatusText" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="Gray" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="Gray"
                               TextWrapping="Wrap"
                               Text="เมื่อเปิด ระบบจะปิด gesture 3 นิ้วของ Windows ชั่วคราว และคืนค่าเมื่อปิดหรือออกจากโปรแกรม" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="เริ่มต้นใช้งาน" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheckBox"
                              Content="เริ่ม OpenTrackpad พร้อม Windows"
                              Checked="StartWithWindowsCheckBox_Changed"
                              Unchecked="StartWithWindowsCheckBox_Changed" />
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="ซ่อนไปที่ tray" Padding="12,4" Margin="0,0,8,0"
                        Click="HideButton_Click" />
                <Button Content="ออก" Padding="12,4" Click="ExitButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
