<Window x:Class="OpenTrackpad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenTrackpad"
        Width="720"
        Height="820"
        MinWidth="620"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Trackpad" FontSize="28" FontWeight="Bold" />
                    <TextBlock x:Name="StatusText" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="กำลังตรวจสอบอุปกรณ์..." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="แบตเตอรี่" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="BatteryText" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Text="--%" />
                        <Button x:Name="RefreshButton" Content="รีเฟรช"
                                Margin="16,0,0,0" Padding="12,3"
                                Click="RefreshButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="AdminText" Margin="0,6,0,0"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="RestartAdminButton" Grid.Column="1"
                        Content="เปิดใหม่แบบ administrator"
                        VerticalAlignment="Top" Padding="12,4"
                        Click="RestartAdmin_Click" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16,10,16,8">
            <TabItem Header="Point &amp; Click">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Tracking speed" FontSize="16" FontWeight="SemiBold" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="CursorSpeedSlider" Minimum="1" Maximum="20"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="CursorSpeedSlider_ValueChanged" />
                            <TextBlock x:Name="CursorSpeedValueText" Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Slow" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Fast" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="Click" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,18,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ClickStrengthSlider" Minimum="0" Maximum="2"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="ClickStrengthSlider_ValueChanged" />
                            <TextBlock x:Name="ClickStrengthValueText" Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Light" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Firm" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="PreviewClickButton" Content="ทดลองสั่น"
                                    Padding="12,4" Click="PreviewClick_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ClickStatusText" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                        <CheckBox x:Name="QuietClickCheckBox" Content="Quiet Click (ไม่มีการสั่น)"
                                  Margin="0,16,0,0"
                                  Checked="QuietClickCheckBox_Changed"
                                  Unchecked="QuietClickCheckBox_Changed" />

                        <CheckBox x:Name="ForceClickCheckBox"
                                  Content="Force Click และ haptic feedback"
                                  IsEnabled="False" IsChecked="True" Margin="0,10,0,0" />
                        <TextBlock Margin="24,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Force Click (กดแรงขั้นที่สอง) ไม่รองรับบน Windows — ใช้ Quiet Click เปิด/ปิดการสั่น" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Look up &amp; data detectors" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" IsEnabled="False" SelectedIndex="0">
                                <ComboBoxItem Content="ไม่รองรับบน Windows" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Secondary click" VerticalAlignment="Center" />
                            <ComboBox x:Name="SecondaryClickCombo" Grid.Column="1"
                                      SelectionChanged="SecondaryClickCombo_SelectionChanged">
                                <ComboBoxItem Content="ปิด" />
                                <ComboBoxItem Content="แตะ 2 นิ้ว" />
                            </ComboBox>
                        </Grid>

                        <CheckBox x:Name="TapToClickCheckBox"
                                  Content="Tap to click (แตะ 1 นิ้ว)"
                                  Margin="0,12,0,0"
                                  Checked="TapToClickCheckBox_Changed"
                                  Unchecked="TapToClickCheckBox_Changed" />

                        <Button Content="คืนค่าเริ่มต้นแท็บนี้ (Reset)"
                                HorizontalAlignment="Left" Margin="0,24,0,0"
                                Padding="12,4" Click="ResetPointClick_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Scroll &amp; Zoom">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <CheckBox x:Name="NaturalScrollCheckBox"
                                  Content="Natural scrolling (content tracks finger movement)"
                                  Checked="NaturalScrollCheckBox_Changed"
                                  Unchecked="NaturalScrollCheckBox_Changed" />
                        <CheckBox x:Name="ZoomCheckBox"
                                  Content="Zoom in or out (pinch with two fingers)"
                                  Margin="0,10,0,0"
                                  Checked="ZoomCheckBox_Changed"
                                  Unchecked="ZoomCheckBox_Changed" />
                        <CheckBox x:Name="SmartZoomCheckBox"
                                  Content="Smart zoom (double-tap with two fingers)"
                                  IsEnabled="False" Margin="0,10,0,0" />
                        <TextBlock Margin="24,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Smart zoom ไม่รองรับบน Windows" />
                        <CheckBox x:Name="RotateCheckBox"
                                  Content="Rotate (rotate with two fingers)"
                                  IsEnabled="False" Margin="0,10,0,0" />
                        <TextBlock Margin="24,2,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Rotate ไม่รองรับบน Windows" />

                        <TextBlock Text="Scroll speed" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,20,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PanSensitivitySlider" Minimum="0" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="PanSensitivitySlider_ValueChanged" />
                            <TextBlock x:Name="PanSensitivityValueText" Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="คืนค่า scroll เดิม" Padding="12,4"
                                    Click="RestoreScroll_Click" />
                            <Button Content="คืนค่าเริ่มต้นแท็บนี้ (Reset)" Padding="12,4"
                                    Margin="8,0,0,0" Click="ResetScrollZoom_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ScrollStatusText" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="More Gestures">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <CheckBox x:Name="DragCheckBox" Content="3-finger drag"
                                  Checked="DragCheckBox_Changed"
                                  Unchecked="DragCheckBox_Changed" />
                        <TextBlock x:Name="DragStatusText" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="เมื่อเปิด ระบบจะปิด gesture 3 นิ้วของ Windows ชั่วคราว และคืนค่าเมื่อปิดหรือออกจากโปรแกรม" />

                        <TextBlock Text="ความเร็วลาก 3 นิ้ว" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,20,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="DragGainSlider" Minimum="0.5" Maximum="1.5"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="DragGainSlider_ValueChanged" />
                            <TextBlock x:Name="DragGainValueText" Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="ช้า" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="เร็ว" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="1.0 = ขยับตามนิ้ว; ค่าที่สูงขึ้นจะเร็วขึ้น (ยังขึ้นกับ pointer acceleration ของ Windows)" />

                        <Button Content="เปิดการตั้งค่า Touchpad ของ Windows"
                                HorizontalAlignment="Left" Margin="0,20,0,0"
                                Padding="12,4" Click="OpenWindowsTouchpad_Click" />
                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="gesture 3/4 นิ้วอื่น ๆ ใช้การตั้งค่าของ Windows ก่อน; ส่วน preset ในแอปจะเพิ่มในรอบถัดไป" />

                        <Button Content="คืนค่าเริ่มต้นแท็บนี้ (Reset)"
                                HorizontalAlignment="Left" Margin="0,24,0,0"
                                Padding="12,4" Click="ResetMoreGestures_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Pointer / palm / pressure" FontSize="16"
                                   FontWeight="SemiBold" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Stop pressure (0xFFFFFFFF = ปิด)"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="StopPressureBox" Grid.Column="1" Margin="0,4"
                                     TextChanged="PointerControl_Changed" />
                            <TextBlock Grid.Row="1" Text="Stop size (0xFFFFFFFF = ปิด)"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="StopSizeBox" Grid.Row="1" Grid.Column="1" Margin="0,4"
                                     TextChanged="PointerControl_Changed" />
                        </Grid>
                        <CheckBox x:Name="IgnoreNearFingersCheck" Content="Ignore near fingers"
                                  Margin="0,8,0,0"
                                  Checked="PointerControl_Changed"
                                  Unchecked="PointerControl_Changed" />
                        <CheckBox x:Name="PalmRejectionCheck" Content="Palm rejection"
                                  Margin="0,4,0,0"
                                  Checked="PointerControl_Changed"
                                  Unchecked="PointerControl_Changed" />
                        <CheckBox x:Name="IgnoreButtonFingerCheck"
                                  Content="Ignore button finger (ลด pointer ขยับตอนคลิก)"
                                  Margin="0,4,0,0"
                                  Checked="PointerControl_Changed"
                                  Unchecked="PointerControl_Changed" />
                        <CheckBox x:Name="ButtonDisabledCheck"
                                  Content="ปิดปุ่มคลิกทั้งแผ่น" Margin="0,4,0,0"
                                  Checked="PointerControl_Changed"
                                  Unchecked="PointerControl_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="โหลดค่าจากไดรเวอร์" Padding="12,4"
                                    Click="ReloadPointer_Click" />
                            <Button Content="หยุด pointer ตอนยกนิ้ว (0 / 7)" Padding="12,4"
                                    Margin="8,0,0,0" Click="ApplyLiftPreset_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="ค่า 0 / 7 เป็นค่าที่ upstream แนะนำ: หยุด pointer เมื่อแรงกดเหลือ 0 หรือขนาดสัมผัสเหลือ 7 units (ลดอาการกระตุกตอนยกนิ้ว)" />
                        <TextBlock x:Name="PointerStatusText" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="การเชื่อมต่อ" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,20,0,0" />
                        <Button Content="เปิดการตั้งค่า Bluetooth"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Padding="12,4" Click="OpenBluetoothSettings_Click" />
                        <TextBlock Margin="0,6,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="ถอดสาย USB แล้วจับคู่ Magic Trackpad ใน Settings > Bluetooth &amp; devices > Add device ถ้าถามรหัสให้ใส่ 0000" />
                        <TextBlock Margin="0,4,0,0" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="หมายเหตุ: การขยับเคอร์เซอร์ผ่าน Bluetooth อาจกระตุกกว่า USB เนื่องจากข้อจำกัดของไดรเวอร์ v2.3 และ Bluetooth stack" />

                        <CheckBox x:Name="StartWithWindowsCheckBox"
                                  Content="เริ่ม OpenTrackpad พร้อม Windows"
                                  Margin="0,20,0,0"
                                  Checked="StartWithWindowsCheckBox_Changed"
                                  Unchecked="StartWithWindowsCheckBox_Changed" />
                        <Button Content="เปิดโฟลเดอร์ log / settings"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Padding="12,4" Click="OpenLogFolder_Click" />

                        <Button Content="คืนค่าเริ่มต้นแท็บนี้ (Reset)"
                                HorizontalAlignment="Left" Margin="0,24,0,0"
                                Padding="12,4" Click="ResetAdvanced_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Padding="12,4" Click="CloseButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
